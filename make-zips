#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="$ROOT_DIR/build"
SRC_DIR="$ROOT_DIR/src"
XPI="$BUILD_DIR/mineru-cli-zotero.xpi"
UPDATES_TMPL="$ROOT_DIR/updates.json.tmpl"
UPDATES_OUT="$ROOT_DIR/updates.json"
REPO="https://github.com/leike0813/mineru-cli-zotero"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"

cd "$SRC_DIR"
zip -r "$XPI" . >/dev/null

echo "Built: $XPI"
unzip -l "$XPI" | sed -n '1,30p'

VERSION="$(python - <<'PY'
import json
from pathlib import Path
manifest = Path("manifest.json")
print(json.loads(manifest.read_text(encoding="utf-8")).get("version", "0.0.0"))
PY
)"

if command -v sha256sum >/dev/null 2>&1; then
  HASH="$(sha256sum "$XPI" | awk '{print $1}')"
elif command -v shasum >/dev/null 2>&1; then
  HASH="$(shasum -a 256 "$XPI" | awk '{print $1}')"
else
  echo "ERROR: sha256sum or shasum not available" >&2
  exit 1
fi

UPDATE_LINK="$REPO/releases/download/v${VERSION}/mineru-cli-zotero.xpi"
UPDATE_HASH="sha256:${HASH}"

if [[ ! -f "$UPDATES_TMPL" ]]; then
  echo "ERROR: updates.json.tmpl not found at $UPDATES_TMPL" >&2
  exit 1
fi

sed \
  -e "s|__VERSION__|${VERSION}|g" \
  -e "s|__UPDATE_LINK__|${UPDATE_LINK}|g" \
  -e "s|__UPDATE_HASH__|${UPDATE_HASH}|g" \
  "$UPDATES_TMPL" > "$UPDATES_OUT"

echo "sha256: $HASH"
echo "Wrote: $UPDATES_OUT"
echo "update_link: $UPDATE_LINK"
